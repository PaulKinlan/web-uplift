diff --git a/assets/css/open-props-dark.css b/assets/css/open-props-dark.css
new file mode 100644
index 0000000..0502d3f
--- /dev/null
+++ b/assets/css/open-props-dark.css
@@ -0,0 +1,16 @@
+@media (prefers-color-scheme: dark) {
+  :where(html) {
+    --link: var(--indigo-3);
+    --link-visited: var(--purple-3);
+    --text-1: var(--gray-1);
+    --text-2: var(--gray-4);
+    --surface-1: var(--gray-9);
+    --surface-2: var(--gray-8);
+    --surface-3: var(--gray-7);
+    --surface-4: var(--gray-6);
+    --scrollthumb-color: var(--gray-6);
+    --shadow-color: 220 40% 2%;
+    --shadow-strength: 10%;
+    color-scheme: dark;
+  }
+}
