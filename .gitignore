# Dependencies
node_modules/

# Audit output - large and regenerable; keep it local, publish only
# aggregates. (testplans/ stays tracked by design: plans are reviewed and
# reused across runs.)
reports/

# Agent scratch lives INSIDE each run directory (under reports/, ignored above):
# the skill directs `<report directory>/scratch/`, and tests/skill-write-contract.mjs
# fails if a top-level scratch/ is instructed or reserved again (web-uplift-16f).

# Local secrets / environment
.env
.env.*

# Logs
*.log
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# npm pack output
*.tgz
.pi-subagents/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
